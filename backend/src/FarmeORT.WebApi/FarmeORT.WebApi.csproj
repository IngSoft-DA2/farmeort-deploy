<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\FarmeORT.Fabrica\FarmeORT.Fabrica.csproj" />
    <ProjectReference Include="..\FarmeORT.IServicios\FarmeORT.IServicios.csproj" />
    <ProjectReference Include="..\FarmeORT.Importacion.Contratos\FarmeORT.Importacion.Contratos.csproj" />

    <!--
      El importador JSON se compila antes que la API, pero la API NO lo referencia
      (ReferenceOutputAssembly="false"): lo descubre por reflection en la carpeta Plugins.
    -->
    <ProjectReference Include="..\FarmeORT.Importadores.Json\FarmeORT.Importadores.Json.csproj"
                      ReferenceOutputAssembly="false" Private="false" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.*">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <!-- La plantilla de desarrollo no se publica: la configuración real llega por variables de entorno. -->
    <Content Update="appsettings.Development.example.json" CopyToPublishDirectory="Never" />
    <Content Update="appsettings.Development.json" CopyToPublishDirectory="Never" />
  </ItemGroup>

  <PropertyGroup>
    <ImportadoresAPlugins>$(MSBuildThisFileDirectory)..\FarmeORT.Importadores.Json\bin\$(Configuration)\$(TargetFramework)\FarmeORT.Importadores.Json.dll</ImportadoresAPlugins>
  </PropertyGroup>

  <!-- dotnet build / dotnet run: copia los importadores a bin/<config>/<tfm>/Plugins -->
  <Target Name="CopiarPluginsAlCompilar" AfterTargets="Build">
    <Copy SourceFiles="$(ImportadoresAPlugins)" DestinationFolder="$(OutDir)Plugins" SkipUnchangedFiles="true" />
  </Target>

  <!--
    dotnet publish: la carpeta publicada es OTRA (la de -o). Sin este paso, Aplicación queda sin importadores:
    con dotnet run funciona y con lo publicado no.
  -->
  <Target Name="CopiarPluginsAlPublicar" AfterTargets="Publish">
    <Copy SourceFiles="$(ImportadoresAPlugins)" DestinationFolder="$(PublishDir)Plugins" SkipUnchangedFiles="true" />
  </Target>

</Project>
